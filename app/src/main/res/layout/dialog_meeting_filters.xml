<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_linear_block"
    android:padding="15dp">

    <!-- Поиск -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_edit_text_disabled"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:padding="0dp">
        <EditText
            android:id="@+id/ett_meetings_filter_go_to_date"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:autofillHints=""
            android:ems="10"
            android:fontFamily="@font/inter"
            android:inputType="date"
            android:textColor="@color/textColor"
            android:background="@drawable/bg_edit_text"
            android:textSize="16sp"
            android:padding="7dp"
            android:textColorHint="@color/textLight"
            android:maxLines="1"
            android:hint="@string/GoToDate"
            android:focusable="false"
            android:cursorVisible="false"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_calendar"
            android:drawableTint="@color/grayBackColor"
            android:paddingEnd="10dp" />
        <DatePicker
            android:id="@+id/dp_meetings_filter_go_to_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:calendarViewShown="false"
            android:spinnersShown="true"
            android:visibility="gone"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/sc_meetings_filter_scroll_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Фильтр, показывать активные -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit_text_disabled"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="0dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:minWidth="120dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="14dp"
                    android:text="@string/FilterViewOnlyActive"
                    android:textColor="@color/textColor"
                    android:textSize="14sp"
                    tools:ignore="RtlSymmetry" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_meetings_filter_view_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="15dp"
                    app:trackTint="@color/switch_track_selector"
                    app:thumbTint="@color/switch_thumb_selector" />
            </LinearLayout>

            <!-- Фильтр, показывать неактивные -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit_text_disabled"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="0dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:minWidth="120dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="14dp"
                    android:text="@string/FilterViewOnlyNotActive"
                    android:textColor="@color/textColor"
                    android:textSize="14sp"
                    tools:ignore="RtlSymmetry" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_meetings_filter_view_not_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="15dp"
                    app:trackTint="@color/switch_track_selector"
                    app:thumbTint="@color/switch_thumb_selector" />
            </LinearLayout>

            <!-- Фильтр, показывать синхронизированные -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit_text_disabled"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="0dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:minWidth="120dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="14dp"
                    android:text="@string/FilterViewOnlySyncByBack"
                    android:textColor="@color/textColor"
                    android:textSize="14sp"
                    tools:ignore="RtlSymmetry" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_meetings_filter_view_sync_by_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="15dp"
                    app:trackTint="@color/switch_track_selector"
                    app:thumbTint="@color/switch_thumb_selector" />
            </LinearLayout>

            <!-- Фильтр, показывать не синхронизированные -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bg_edit_text_disabled"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="0dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:minWidth="120dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="14dp"
                    android:text="@string/FilterViewOnlyNotSyncByBack"
                    android:textColor="@color/textColor"
                    android:textSize="14sp"
                    tools:ignore="RtlSymmetry" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_meetings_filter_view_not_sync_by_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="15dp"
                    app:trackTint="@color/switch_track_selector"
                    app:thumbTint="@color/switch_thumb_selector" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Buttons -->
    <LinearLayout
        android:id="@+id/ll_meetings_filters_btn_container"
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="15dp">

        <Button
            android:id="@+id/btn_meetings_filters_cancel"
            style="?android:attr/buttonBarNegativeButtonStyle"
            android:text="@string/Cancel"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:minWidth="120dp"/>

        <Button
            android:id="@+id/btn_meetings_filters_apply"
            style=""
            android:text="@string/Apply"
            android:layout_marginStart="12dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:minWidth="120dp" />

    </LinearLayout>

</LinearLayout>
