<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_edit_text_disabled"
    android:layout_marginBottom="15dp"
    android:padding="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="0dp">
        <TextView
            android:id="@+id/tv_meetings_group_by_day"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp"/>
        <ImageButton
            android:id="@+id/btn_add_meeting"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:background="@drawable/bg_rectangle_button_small"
            android:contentDescription="@string/CreateMeeting"
            android:layout_margin="5dp"
            android:src="@drawable/ic_plus"
            app:tint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="TouchTargetSize" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_meetings_by_day_arr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="3dp"
        android:nestedScrollingEnabled="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyMeetings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="0dp"
        android:paddingBottom="5dp"
        android:gravity="center_horizontal"
        android:text="@string/NoMeetings"
        android:textSize="14sp"
        android:fontFamily="@font/inter"
        android:visibility="gone" />

</LinearLayout>
