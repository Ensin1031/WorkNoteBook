<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/page_meeting_item_container"
    android:background="@color/lightLightGray"
    tools:context=".MeetingItemActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/meeting_item_header"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_meeting_item_header_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="@string/goToBack"
            android:textColor="@color/textLight"
            android:textSize="16sp"
            android:layout_marginHorizontal="15dp"
            app:drawableStartCompat="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/btn_save_meeting_header"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_check_green"
            android:contentDescription="@string/save"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?selectableItemBackgroundBorderless"
            android:layout_marginHorizontal="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/meeting_item_header_progress_bar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="15dp"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_meeting_item_header_menu"
            app:layout_constraintStart_toEndOf="@+id/btn_save_meeting_header"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.466"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_edit_meeting_header"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit"
            android:padding="8dp"
            android:src="@drawable/ic_pencil_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_meeting_item_header_menu"
            app:layout_constraintStart_toEndOf="@id/btn_save_meeting_header"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="gone"/>

        <ImageButton
            android:id="@+id/btn_meeting_alarm_sync_header"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit"
            android:padding="0dp"
            android:src="@drawable/ic_earth"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_meeting_item_header_menu"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/redDarkColor"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_meeting_item_header_menu"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_three_dots_vertical"
            android:contentDescription="@string/menu"
            android:padding="8dp"
            android:layout_marginHorizontal="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/textColor"
            android:visibility="gone" />

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/textLight"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/page_meeting_item_upper_priority_marker"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/meeting_item_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/page_meeting_item_scroll_container" />

    <ScrollView
        android:id="@+id/page_meeting_item_scroll_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="200dp"
        app:layout_constraintBottom_toTopOf="@+id/meeting_item_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/meeting_item_header">

        <LinearLayout
            android:id="@+id/page_meeting_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/tv_meeting_item_update_at"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter"
                android:text=""
                android:textColor="@color/textColor"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_meeting_item_is_archive_record"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:text="@string/ArchiveRecord"
                android:textColor="@color/redDarkColor"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/meeting_title"
                android:textColor="@color/textColor"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="5dp" />

            <EditText
                android:id="@+id/et_meeting_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:autofillHints="@string/enter_meeting_title"
                android:background="@drawable/bg_edit_text"
                android:fontFamily="@font/inter"
                android:hint="@string/enter_meeting_title"
                android:inputType="text|textMultiLine"
                android:maxLines="3"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/textColor"
                android:textColorHint="@color/textLight"
                android:textSize="16sp"
                android:enabled="false"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/meeting_location"
                android:textColor="@color/textColor"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="5dp" />

            <EditText
                android:id="@+id/et_meeting_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:autofillHints="@string/enter_meeting_location"
                android:background="@drawable/bg_edit_text"
                android:fontFamily="@font/inter"
                android:hint="@string/enter_meeting_location"
                android:inputType="text|textMultiLine"
                android:maxLines="2"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/textColor"
                android:textColorHint="@color/textLight"
                android:textSize="16sp"
                android:enabled="false"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/meeting_description"
                android:textColor="@color/textColor"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="5dp" />

            <EditText
                android:id="@+id/et_meeting_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:autofillHints="@string/enter_meeting_description"
                android:background="@drawable/bg_edit_text"
                android:fontFamily="@font/inter"
                android:gravity="top"
                android:hint="@string/enter_meeting_description"
                android:inputType="text|textMultiLine|textCapSentences"
                android:maxLines="20"
                android:minLines="4"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:textColor="@color/textColor"
                android:textColorHint="@color/textLight"
                android:textSize="16sp"
                android:enabled="false" />

            <!-- Блок ввода даты начала / окончания -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="0dp">
                <!-- Дата начала -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="0dp"
                    android:layout_marginEnd="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/EndDate"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/textColor"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="5dp"/>
                    <EditText
                        android:id="@+id/et_meeting_start_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:fontFamily="@font/inter"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:autofillHints=""
                        android:inputType="date"
                        android:maxLines="1"
                        android:hint="@string/AddDate"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:drawableTint="@color/grayBackColor"
                        android:paddingEnd="10dp"
                        android:layout_marginBottom="16dp"/>
                </LinearLayout>
                <!-- Дата окончания -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="0dp"
                    android:layout_marginStart="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/EndDate"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/textColor"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="5dp"/>
                    <EditText
                        android:id="@+id/et_meeting_end_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:fontFamily="@font/inter"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:autofillHints=""
                        android:inputType="date"
                        android:maxLines="1"
                        android:hint="@string/AddDate"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:drawableTint="@color/grayBackColor"
                        android:paddingEnd="10dp"
                        android:layout_marginBottom="16dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Блок ввода времени начала / окончания -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="0dp">
                <!-- Время начала -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="0dp"
                    android:layout_marginEnd="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/StartTime"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/textColor"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="5dp"/>
                    <EditText
                        android:id="@+id/et_meeting_start_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:fontFamily="@font/inter"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:autofillHints=""
                        android:inputType="time"
                        android:maxLines="1"
                        android:hint="@string/AddTime"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_clock"
                        android:drawableTint="@color/grayBackColor"
                        android:paddingEnd="10dp"
                        android:layout_marginBottom="16dp"/>
                </LinearLayout>
                <!-- Время окончания -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="0dp"
                    android:layout_marginStart="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/EndTime"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/textColor"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="5dp"/>
                    <EditText
                        android:id="@+id/et_meeting_end_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:fontFamily="@font/inter"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:autofillHints=""
                        android:inputType="time"
                        android:maxLines="1"
                        android:hint="@string/AddTime"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_clock"
                        android:drawableTint="@color/grayBackColor"
                        android:paddingEnd="10dp"
                        android:layout_marginBottom="16dp"/>
                </LinearLayout>
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/meeting_notes_content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edit_text">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/meeting_notes_header"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/textLight"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="@string/MeetingNotes"
                        android:textSize="18sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/btn_create_meeting_note"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/save"
                        android:focusable="true"
                        android:padding="0dp"
                        android:src="@drawable/ic_plus"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/primaryBTNColor"
                        android:visibility="gone"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <FrameLayout
                    android:id="@+id/fl_meeting_notes"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/meeting_notes_header" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/meeting_item_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingVertical="5dp"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="@string/rowCreatedInfo"
            android:textColor="@color/textLight"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_meeting_item_create_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:layout_marginStart="10dp"
            android:text=""
            android:textColor="@color/textLight"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_edit_meeting"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_rectangle_button"
        android:contentDescription="@string/CreateMeeting"
        android:layout_margin="20dp"
        android:elevation="6dp"
        android:src="@drawable/ic_pencil_green"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
